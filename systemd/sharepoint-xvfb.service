[Unit]
Description=SharePoint Manager — Xvfb (display X virtual para el Chrome real keep-alive)
After=graphical-session.target

[Service]
Type=simple
EnvironmentFile=/home/daniel/claudecode/sharepoint-manager/config.env
# -ac: sin control de acceso (solo local); -nolisten tcp: sin X por red.
# x11vnc y Chrome se conectan por el socket unix de este display.
ExecStart=/usr/bin/Xvfb ${SPM_DISPLAY} -screen 0 1280x1024x24 -ac -nolisten tcp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
