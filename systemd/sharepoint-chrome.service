[Unit]
Description=SharePoint Manager — Chrome real keep-alive (fuente de token vía CDP)
# Corre sobre el Xvfb; si el display cae, este servicio también.
BindsTo=sharepoint-xvfb.service
After=sharepoint-xvfb.service

[Service]
Type=simple
WorkingDirectory=/home/daniel/claudecode/sharepoint-manager
EnvironmentFile=/home/daniel/claudecode/sharepoint-manager/config.env
ExecStart=/home/daniel/claudecode/sharepoint-manager/bin/chrome-xvfb.sh
# Restart SOLO on-failure: reiniciar Chrome PIERDE la sesión M365 (requiere re-login por VNC),
# no es recuperación automática. Si Chrome cae, el watchdog/health avisan "login requerido".
# NUNCA usar Restart=always aquí: respawnear daría un Chrome deslogueado en bucle.
Restart=on-failure
RestartSec=10
KillMode=control-group
TimeoutStopSec=20

[Install]
WantedBy=default.target
