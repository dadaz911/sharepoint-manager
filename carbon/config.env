# Config carbon — el HOST DE DATOS, donde corre subir_masivo.py sobre los archivos locales.
#
# Hasta 2026-08-17 carbon no tenía NADA versionado acá: el token lo jalaba un `token-pull`
# improvisado que colgaba del ciclo de vida de la corrida del cargue. Al terminar el cargue el
# 7-ago, carbon quedó con un access token congelado 8 días y toda consulta devolvió HTTP 401.
# El host que hace el trabajo real era el único sin aprovisionamiento.
#
# FORMATO: esto lo lee `EnvironmentFile=` de systemd, NO un shell. Solo se ignoran las líneas
# que EMPIEZAN por # — un comentario al final de una línea de valor queda DENTRO del valor.
# Ya pasó (2026-08-17): PI_HOST terminó siendo "raspberrypi3# productor: la Pi siempre
# encendida" y el pull falló con "productor inalcanzable". Comentarios en su propia línea.

# Productor: la Pi, siempre encendida.
PI_HOST="raspberrypi3"

# Ruta del token EN la Pi.
PI_TOKEN="/home/daniel/.cache/spm/.token"

# Destino local: es el mismo SPM_TOKEN_FILE que lee el motor de subida.
TOKEN_FILE="/home/daniel/.cache/spm/.token"

# Minutos de vida bajo los cuales un token se considera inútil.
MIN_VIDA="5"
