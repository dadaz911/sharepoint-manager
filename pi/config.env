# Config del token_refresher EN LA PI (raspberrypi3, siempre encendida).
# La leen el daemon (EnvironmentFile=) y, si se corre a mano, bash (source).
TENANT="cd422ec3-3717-412e-ba56-3bdab9a2f7ef"
CLIENT_ID="d3590ed6-52b3-4102-aeff-aad2292ab01c"
SCOPE="https://shdgov-my.sharepoint.com/.default offline_access"
# Token de acceso (escrito localmente en la Pi; gold lo JALA con rsync).
TOKEN_FILE="/home/daniel/.cache/spm/.token"
# Refresh token (credencial de larga vida; 0600).
RT_FILE="/home/daniel/.config/sharepoint-manager/refresh_token"
PERSONAL_SITE="https://shdgov-my.sharepoint.com/personal/dzuniga_shd_gov_co1"
DEST_FOLDER="/personal/dzuniga_shd_gov_co1/Documents/Pruebas"
# Refrescar cada 50 min (el token dura ~65). gold jala cada ~10 min.
REFRESH_EVERY="3000"
