# Config por defecto al ejecutar los scripts DESDE el repo (bin/pull-token.sh la toma como
# respaldo si no hay SPM_CONFIG ni EnvironmentFile).
#
# En despliegue real cada host usa la suya: gold/, carbon/, silver/, pi/ — instaladas por
# deploy.sh en ~/.config/sharepoint-manager/pull.env e inyectadas por systemd.
PI_HOST="raspberrypi3"
PI_TOKEN="/home/daniel/.cache/spm/.token"
TOKEN_FILE="/home/daniel/.cache/spm/.token"
MIN_VIDA="5"
