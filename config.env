# Config gold del lado OAuth de sharepoint-manager.
# El refresher OAuth corre en la Pi (ver pi/); gold solo vigila la salud del token y, si
# alguna vez corre cargas localmente, puede jalar el token con bin/pull-token.sh.
PI_HOST="raspberrypi3"                                   # nodo siempre-encendido que refresca
PI_TOKEN="/home/daniel/.cache/spm/.token"                # ruta del token en la Pi
TOKEN_FILE="/home/daniel/Desktop/Cargue a Onedrive/.token"  # destino local si gold jala el token
