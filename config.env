# Configuración central de sharepoint-manager (fuente única de verdad).
#
# La consumen DOS mundos:
#   - scripts bash:    source config.env
#   - units systemd:   EnvironmentFile=.../config.env
#
# Reglas de compatibilidad (importantes):
#   - Comillas dobles: bash las quita al sourcear y systemd también las interpreta
#     en EnvironmentFile, así que valores con ESPACIOS (TOKEN_FILE) funcionan en ambos.
#   - systemd NO expande $HOME ni $VAR en EnvironmentFile → rutas absolutas literales.

# Ruta canónica del token. Es la que YA usan token_daemon.py, refresh_token.py y
# explorador_sharepoint.py, y donde existe el archivo real. NO cambiar sin migrar esos tres.
TOKEN_FILE="/home/daniel/Desktop/Cargue a Onedrive/.token"

# Puerto del Chrome DevTools Protocol (solo localhost; el token nunca se expone en red).
CDP_PORT="9222"

# URL de SharePoint/OneDrive del tenant SHD.
ONEDRIVE_URL="https://shdgov-my.sharepoint.com"

# Perfil dedicado de Chrome (separado del perfil personal; guarda la sesión M365).
CHROME_PROFILE="/home/daniel/.config/chrome-sharepoint"

# Display X virtual (Xvfb) donde corre el Chrome REAL de larga vida. Se eligió un número
# alto para no chocar con el escritorio real de gold (:0 / wayland-0).
# MODELO KEEP-ALIVE: M365 no re-autentica en silencio un Chrome reiniciado (ni headless ni
# real), así que el Chrome que hace login se mantiene vivo y NUNCA se reinicia en operación.
# El login se hace vía VNC contra ESE mismo Chrome (no se relanza).
SPM_DISPLAY=":77"

# Puerto VNC (solo localhost) que se abre temporalmente durante 'spm.sh login'.
VNC_PORT="5900"
